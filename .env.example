# Production example: replace placeholders in Render, never commit real secrets.
ENVIRONMENT=production
API_SECRET_KEY=replace-with-an-independent-random-secret
API_DEBUG=false
DATABASE_URL=postgresql+psycopg://user:password@host/fulbacho?sslmode=require
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
DJANGO_SECRET_KEY=replace-with-another-independent-random-secret
DJANGO_DEBUG=false
ALLOWED_HOSTS=...
CSRF_TRUSTED_ORIGINS=...
API_BASE_URL=http://127.0.0.1:8001/api/v1
API_TIMEOUT_SECONDS=10
WEB_DATABASE_URL=postgresql://user:password@host/fulbacho_web?sslmode=require
CORS_ORIGINS=
