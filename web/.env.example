DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# Para ejecutar Django/FastAPI directamente en el host.
# Docker Compose sobrescribe esta URL con http://api:8000/api/v1
API_BASE_URL=http://127.0.0.1:8001/api/v1
API_TIMEOUT_SECONDS=10
# Optional. The Django database stores web sessions only; Fulbacho domain data lives behind FastAPI.
# WEB_DATABASE_URL=postgresql://user:password@host/dbname
